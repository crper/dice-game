{
  "name": "dice-game-3d",
  "version": "1.0.0",
  "description": "A 3D dice game built with React, TypeScript, Three.js and Tailwind CSS — Liar's Dice (大话骰) with hidden hands and bidding, plus an open-roll mode. Rigid-body tumbling, responsive layout, GitHub Pages ready.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dice",
    "3d",
    "react",
    "typescript",
    "three",
    "threejs",
    "vite",
    "tailwindcss",
    "liars-dice",
    "game"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crper/dice-game.git"
  },
  "homepage": "https://crper.github.io/dice-game/",
  "bugs": {
    "url": "https://github.com/crper/dice-game/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "verify:faces": "node scripts/verify-faces.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run verify:faces"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
